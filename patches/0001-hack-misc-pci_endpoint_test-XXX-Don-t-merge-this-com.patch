From 7ea208648ed23e32a45f79d9ee8b1109da4a3f54 Mon Sep 17 00:00:00 2001
From: Shunsuke Mie <mie@igel.co.jp>
Date: Thu, 7 Mar 2024 15:58:37 +0900
Subject: [PATCH] hack: misc: pci_endpoint_test: XXX: Don't merge this commit

for the qemu epc testing, change irq type of TI epc, MSI into
LEGACY_IRQ.
---
 drivers/misc/pci_endpoint_test.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/misc/pci_endpoint_test.c b/drivers/misc/pci_endpoint_test.c
index 6b18ea914689..3c7e37fb272c 100644
--- a/drivers/misc/pci_endpoint_test.c
+++ b/drivers/misc/pci_endpoint_test.c
@@ -1043,8 +1043,8 @@ static int pci_endpoint_test_set_irq(struct pci_endpoint_test *test,
 		else if (test->ep_caps & CAP_INTX)
 			req_irq_type = PCITEST_IRQ_TYPE_INTX;
 		else
-			/* fallback to MSI if no caps defined */
-			req_irq_type = PCITEST_IRQ_TYPE_MSI;
+			/* QEMU endpoint bridge only supports INTx. */
+			req_irq_type = PCITEST_IRQ_TYPE_INTX;
 	}
 
 	if (test->irq_type == req_irq_type)
-- 
2.53.0

