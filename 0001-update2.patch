+/* Called with access_lock held; waiting releases it for guest completion. */
+static int qemu_epc_bar_access(QemuEPCState *s, int bar, size_t offset,
+                               size_t size, bool write, uint64_t *value)
+{
+    int64_t deadline = g_get_monotonic_time() + 5000000;
+    int ret = 0;
+
+    s->access_offset = offset;
+    s->access_data = *value;
+    s->access_error = 0;
+    if (++s->access_id == 0) {
+        ++s->access_id;
+    }
+    s->access_info = (1U << 31) | (write ? 1U << 30 : 0) |
+                     (bar << 16) | size;
+    while (s->access_info && s->started) {
+        if (g_get_monotonic_time() >= deadline) {
+            error_report("qemu-epc: BAR request timed out");
+            ret = -1;
+            break;
+        }
+        qemu_cond_timedwait(&s->access_cond, &s->access_lock, 100);
+    }
+    if (!s->started || s->access_error) {
+        ret = -1;
+    }
+    *value = ret ? UINT64_MAX : s->access_data;
+    s->access_info = 0;
+    return ret;
+}
